# Brief delivery (Spec §14) through Resend's HTTP API. All three are required: without them
# the form answers with an honest error — "Brief recibido." only appears after a 2xx from Resend.
# CONTACT_FROM must be a sender on a domain verified in Resend.
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=

# Development / preview only: print each placeholder's asset key on it (Spec §22).
NEXT_PUBLIC_SHOW_ASSET_KEYS=
